# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# PyInstaller
build/
build_output/
dist/
*.spec.bak

# Runtime / User data (developer local session files)
cafepulse.db
logs/
exports/

# Developer session flags — runtime files, not for distribution
config/.clean
config/.lock
config/license.lic
config/settings.json

# Malformed directory (created by shell error — safe to ignore)
{core/

# IDE
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Scratch / temp
scratch/
test_out.txt
crash_debug.txt
*.tmp
temp/
TEMP/
*.db-wal
*.db-shm
LOCAL_BACKUPS/
exports/licenses/

# Licensing secrets and pregenerated list
core/licensing/secrets.py
core/licensing/private_key.pem
core/licensing/public_key.pem
docs/100_PREGENERATED_COMMERCIAL_LICENSES.md

# Developer internal audit reports (relocated to docs/internal_audits/)
docs/internal_audits/
*.md.bak

# RSA Licensing
*.lic
*.licreq
*.key
*.pem
!core/licensing/public_key.pem

# License generator outputs
generated_licenses/
licenses/
license_output/

# RSA test artifacts
test_founder.licreq
test_commercial.licreq

# Build artifacts (exclude website release files from this rule)
*.exe
*.msi
*.zip
# Allow installer files hosted on the website
!website/releases/**/*.exe
!website/releases/**/*.zip

# PyInstaller extraction
*_extracted/

# Local reports
*_Audit_Report.pdf
